.env

# Saved images / archives
*.tar.gz
*.tar

# OS junk
.DS_Store
Thumbs.db

# Docs (not needed inside container)
docs/

# Dev dependencies
requirements-dev.txt

# Docker folder - exclude everything except entrypoint.sh (needed by COPY)
docker/Dockerfile
docker/docker-compose.yml
