# JIRA Configuration
JIRA_SERVER=https://redhat.atlassian.net
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_EMAIL=your_email@redhat.com

# CephCI Configuration
CEPHCI_REPO_URL=https://github.com/red-hat-storage/cephci.git
CEPHCI_BRANCH=main
CEPHCI_LOCAL_PATH=./cephci

# GitLab — cephci-openshift DataVolume YAMLs (guest image compose URLs for kernel discovery)
GITLAB_URL=https://gitlab.cee.redhat.com
GITLAB_TOKEN=your_gitlab_pat
GITLAB_PROJECT=rhcs-qe/cephci-openshift
GITLAB_BRANCH=main
GITLAB_DV_PATH=rhel-guest-images

# OCP Virtualization (KubeVirt) — auth only.
# API server, namespace, storage, network, and datasources come from
# conf/ocpvirt/rdu3_ceph_sys_test.yaml in the cephci repo (runtime ns: ceph-sys-test--runtime-int).
OCPVIRT_TOKEN=your_service_account_bearer_token
# Preferred: base64 certificate-authority-data from kubeconfig
OCPVIRT_CERTIFICATE_AUTHORITY_DATA=
# Alternative to certificate_authority_data: path to a PEM CA bundle
OCPVIRT_SSL_CA_CERT=
# Optional: SSH private key on the runner for guest access
OCPVIRT_PRIVATE_KEY_PATH=~/.ssh/id_ed25519

# Log Storage Configuration (SCP to remote host)
LOG_STORAGE_HOST=magna002.ceph.redhat.com
LOG_STORAGE_PATH=/ceph/ceph-qe-logs/your_user/logs/kernel-logs
LOG_STORAGE_USER=your_ssh_username
SSH_KEY_PATH=~/.ssh/id_rsa

# Application Configuration
LOG_LEVEL=INFO
LOG_DIR=./data/logs
JIRA_CACHE_DIR=./data/jira_cache
CONFIG_DIR=./config

# GitHub Pages Dashboard
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/kernel-bz-dashboard
