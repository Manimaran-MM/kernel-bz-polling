# JIRA Configuration
JIRA_SERVER=https://redhat.atlassian.net
JIRA_API_TOKEN=your_jira_api_token_here
JIRA_EMAIL=your_email@redhat.com

# CephCI Configuration
# Your fork or the main repo
CEPHCI_REPO_URL=https://github.com/red-hat-storage/cephci.git
# Branch to use (master, pr-kernel-bz, etc.)
CEPHCI_BRANCH=master
# Local path where cephci repo will be cloned
# Use relative path (./cephci) to clone in project root - no sudo needed
# Use absolute path (/opt/cephci) only if you have permissions
CEPHCI_LOCAL_PATH=./cephci

# OpenStack / RHOS-D Configuration
OPENSTACK_AUTH_URL=https://rhos-d.infra.prod.upshift.rdu2.redhat.com:13000
OPENSTACK_USERNAME=73cf50f58d7a4ebf8c7d8dc9ac930483
OPENSTACK_PASSWORD=just_the_work
OPENSTACK_PROJECT_NAME=ceph-sys-test
OPENSTACK_DOMAIN=redhat.com
OPENSTACK_TENANT_DOMAIN_ID=62cf1b5ec006489db99e2b0ebfb55f57
OPENSTACK_REGION=regionOne

# Log Storage Configuration
LOG_STORAGE_HOST=magna002.ceph.redhat.com
LOG_STORAGE_PATH=/ceph/ceph-qe-logs/manim/logs/kernel-logs
LOG_STORAGE_USER=
SSH_KEY_PATH=~/.ssh/id_rsa

# Scheduler Configuration
POLL_INTERVAL_HOURS=24
POLL_TIME_UTC=00:00
MAX_CONCURRENT_JOBS=5

# Application Configuration
LOG_LEVEL=INFO
LOG_DIR=./data/logs
JIRA_CACHE_DIR=./data/jira_cache
CONFIG_DIR=./config

# Dashboard Configuration
DASHBOARD_PORT=5000
DASHBOARD_HOST=0.0.0.0
STATS_UPDATE_INTERVAL=300

# GitHub Pages Configuration (for CI/CD)
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/kernel-bz-polling